{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paddock-academias-portal",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paddock-academias-portal-db",
      "database_id": "78ae3333-6d87-42ad-afdd-0dfb3f605647",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
